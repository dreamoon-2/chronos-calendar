{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chronos Calendar",
  "version": "0.3.1",
  "identifier": "com.chronos.calendar",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Chronos Calendar",
        "width": 1200,
        "height": 800,
        "minWidth": 400,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "category": "Productivity",
    "shortDescription": "跨端同步日程表",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkzNjNFOEQ0Mzk2RTI1NDcKUldSSEpXNDUxT2hqazloSFAySU94ZTd1NGVsN0pmVVM5cjVkWFNScjE1SVVDQ1FqaFRJYlhGZjcK",
      "endpoints": [
        "https://github.com/dreamoon-2/chronos-calendar/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
